rules_version = '2';
// 공개 자료(물건·공고·시세)는 누구나 읽기, 쓰기는 수집 서버(관리자 SDK)와 관리자만.
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.token.email in ['deepgreen7857@gmail.com'];
    }
    match /listings/{id}        { allow read: if true; allow write: if isAdmin(); }
    // 화면용 묶음 자료(물건·완료 결과·시세를 하루 한 번 묶은 것) — 원본 컬렉션과 같은 공개 범위, 쓰기는 수집 서버만
    match /snapshots/{name}     { allow read: if true; allow write: if false;
      match /chunks/{id}        { allow read: if true; allow write: if false; }
    }
    match /pastResults/{id}     { allow read: if true; allow write: if false; }
    match /bankruptNotices/{id} { allow read: if true; allow write: if false; }
    // 파산 공고 첨부 원문 글자(대법원 공개 공고) — 누구나 읽기
    match /bankruptTexts/{id}   { allow read: if true; allow write: if false; }
    match /tradeMonths/{id}     { allow read: if true; allow write: if false; }
    match /landCache/{id}       { allow read: if true; allow write: if false; }
    match /settings/{id}        { allow read: if true; allow write: if isAdmin(); }
    // 정비구역 목록(사람이 추진현황·공보로 확인) — 관리자 전용. 물건에는 서버가 공개 가능한 값만 스냅숏으로 붙인다
    match /redevZones/{id}      { allow read, write: if isAdmin(); }
    match /redevZoneFiles/{id}  { allow read: if true; allow write: if isAdmin(); }
    match /adminAlerts/{id}     { allow read, write: if isAdmin(); }
    match /state/{id}           { allow read: if isAdmin(); allow write: if false; }
    match /tradeProgress/{id}   { allow read: if isAdmin(); allow write: if false; }
    match /quota/{id}           { allow read: if isAdmin(); allow write: if false; }
    match /runs/{id}            { allow read: if isAdmin(); allow write: if false; }
    match /ruleSuggestions/{id} { allow read: if isAdmin(); allow write: if isAdmin(); }
    // 등기부 열람본(이름·주소 포함) — 관리자만 읽음, 쓰기는 수집 서버만
    match /registry/{id}        { allow read: if isAdmin(); allow write: if false; }
    // 법원 첨부 PDF 열기 주소(감정평가서·현황조사서·매각물건명세서) — 관리자만 읽음, 쓰기는 수집 서버만
    match /courtFiles/{id}      { allow read: if isAdmin(); allow write: if false; }
    // 여러 물건이 함께 쓰는 문서(병합·중복사건) — 관리자 전용
    match /courtDocShared/{id}  { allow read: if isAdmin(); allow write: if false; }
    // 자료 보기(jbslab.co.kr/data) — 미니PC 원본 하드 사본(감정평가서·명세서·현황조사서·사진) 열기 주소. 관리자만 읽음, 쓰기는 수집 서버만
    match /dataCases/{id}       { allow read: if isAdmin(); allow write: if false; }
    // 정비사업 검토 작업 저장(jbslab.co.kr 모든 검토 화면의 [작업 저장·불러오기] → 홈페이지에 저장) — 관리자만 읽고 씀. 토지조서 등이 들어 있을 수 있음
    match /jbsWork/{id}         { allow read, write: if isAdmin();
      match /chunks/{n}         { allow read, write: if isAdmin(); }
    }
  }
}
